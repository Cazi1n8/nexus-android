# MediaPipe model is downloaded from the official versioned URL by setup/CI.
app/src/main/assets/hand_landmarker.task
app/src/main/assets/.hand_model_*

# Generated CMake outputs and verified third-party runtime sources.
**/.cxx/
app/src/main/cpp/vendor/
# Generated/downloaded LLM weights stay out of Git. A bundled build may package
# the explicitly prepared compact asset; ordinary optional weights stay private.
*.gguf
*.gguf.part
# Verified OCR assets are prepared before compilation and bundled into the APK.
app/src/main/assets/ocr/*.traineddata
app/src/main/assets/ocr/.ocr-model-*
# Verified object classification model and official test image are prepared by CI.
app/src/main/assets/vision/*.tflite
app/src/androidTest/assets/vision/*.jpg
# JVM crash/replay diagnostics can contain private execution context.
hs_err_pid*.log
replay_pid*.log
