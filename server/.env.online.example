# Public configuration EXAMPLE. Copy outside the checkout to a private file.
# No real provider keys, invitations or access/refresh tokens belong in Git/APK.
NEXUS_BIND=127.0.0.1
NEXUS_PORT=8787
NEXUS_PROVIDER=anthropic
NEXUS_MODEL=claude-haiku-5-5
UPSTREAM_API_KEY=
# Set only if the provider account requires workspace selection:
# NEXUS_UPSTREAM_WORKSPACE_ID=
# Built-in provider endpoints are selected by NEXUS_PROVIDER.
# For advanced/generic OpenAI-compatible servers only:
# NEXUS_PROVIDER=generic
# UPSTREAM_BASE_URL=https://operator-owned.example.invalid/v1

# Persistent private state. Never put this database in a public checkout.
NEXUS_SESSION_DB=/var/lib/nexus-ai/sessions.sqlite3
NEXUS_ACCOUNT_DAILY_REQUESTS=100
NEXUS_GLOBAL_DAILY_REQUESTS=1000
# Conservative reservation: input UTF-8 bytes + max output tokens * 4.
# These are NOT measured provider tokens or USD; provider billing limits are required.
NEXUS_ACCOUNT_DAILY_UNITS=8000000
NEXUS_GLOBAL_DAILY_UNITS=80000000
NEXUS_RATE_PER_MINUTE=30
NEXUS_CONCURRENCY=2
NEXUS_UPSTREAM_TIMEOUT_SECONDS=90
NEXUS_MODEL_VISION=true

# Optional SearXNG under the developer's control; not deployed by this example.
# NEXUS_SEARCH_BASE_URL=https://search.operator-owned.example.invalid
# NEXUS_ACCESS_TOKEN and its legacy TTL belong to the old controlled bridge;
# they are not an app-wide secret and are not required for individual sessions.
