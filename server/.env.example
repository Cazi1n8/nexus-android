# Exemplo público: copie e preencha em .env.local, que fica fora do Git.
# Preferível: python3 server/setup_local.py gera esse arquivo com token aleatório.
NEXUS_ACCESS_TOKEN=
NEXUS_MODEL=gemma3:4b
NEXUS_BIND=127.0.0.1
NEXUS_PORT=8787
NEXUS_TOKEN_TTL_SECONDS=28800
NEXUS_RATE_PER_MINUTE=30
NEXUS_CONCURRENCY=2
NEXUS_UPSTREAM_TIMEOUT_SECONDS=90

# Opção gratuita, executada no seu próprio computador:
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Opção com outro provedor: URL da API (base /v1 ou endpoint completo).
# A chave privada fica somente no servidor.
# UPSTREAM_BASE_URL=https://seu-provedor.example/v1
# UPSTREAM_API_KEY=

# Declaração do operador; não substitui um teste real de imagens.
NEXUS_MODEL_VISION=false
# Pesquisa opcional: instância SearXNG administrada por você, API JSON habilitada.
# Só o operador escolhe esse destino. O app envia somente a consulta.
# NEXUS_SEARCH_BASE_URL=http://127.0.0.1:8888
